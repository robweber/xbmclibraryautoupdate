msgctxt "#30079"
msgid "Select how often to start library scans"
msgstr "Odaberite koliko često želite pokretati skeniranje biblioteke"

msgctxt "#30080"
msgid "Set a custom interval using cron syntax - example is '15 */5 * * *' for quarter past the hour every 5 hours every day"
msgstr "Postavite prilagođeni interval koristeći cron sintaksu - primjer je '15 */5 * * *' za petnaest minuta svakih 5 sati svakog dana"

msgctxt "#30081"
